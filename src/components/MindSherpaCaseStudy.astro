---
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignTodo from './DesignTodo.astro';
import '../styles/mindsherpa.css';
import '../styles/mindsherpa-media.css';

const { locale = 'en' } = Astro.props;
const es = locale === 'es';
const root = es ? '/es/' : '/';
const A = '/projects/mindsherpa/';
const covers = ['Book-Cover-Design.jpg','Book-Cover-Design_EDC.jpg','Book-Cover-Design_HE.jpg','Book-Cover-Design_UAP.jpg'];
const completeArchive = [...covers,'Libros.jpg','TablerCarlos.png','Sin-titulo-1-1080x619.png','PSD-TYHUMB.jpg','JESUS-Y-ANANDA-LOGO.png',...Array.from({length:6},(_,i)=>`mindsherpa_${i+1}.webp`)];
const title = (en, spa) => es ? spa : en;
const capabilities = ['Book Cover Design','Editorial Design','Digital Publishing','Art Direction','Visual Identity','Web Design','Video Editing','Audiovisual Design'];
const sections = {
  context: title('Readers meet a publication as a thumbnail, title, cover and description before it becomes a reading experience. For Mind Sherpa, design creates continuity between recognition, publication and reading.','Los lectores encuentran una publicación como miniatura, título, portada y descripción antes de convertirla en una experiencia de lectura. Para Mind Sherpa, el diseño crea continuidad entre reconocimiento, publicación y lectura.'),
  cover: title('Book covers operate simultaneously as image, typography and proposition. They need recognition at thumbnail scale, detail at full size and enough individuality to belong together without becoming identical.','Las portadas funcionan simultáneamente como imagen, tipografía y propuesta. Necesitan reconocimiento como miniatura, detalle a tamaño completo y suficiente individualidad para convivir sin volverse idénticas.'),
  interior: title('Once the book opens, spectacle gives way to rhythm. Chapter openings, headings, paragraphs, spacing, quotations and navigation support long-form reading without interrupting it.','Cuando el libro se abre, el espectáculo da paso al ritmo. Aperturas de capítulo, encabezados, párrafos, espacios, citas y navegación sostienen la lectura prolongada sin interrumpirla.'),
  kindle: title('On Kindle, screen size, font size and line length change. The hierarchy must survive reflow instead of depending on a fixed page composition.','En Kindle cambian el tamaño de pantalla, la tipografía y la longitud de línea. La jerarquía debe sobrevivir al contenido fluido sin depender de una composición fija.'),
};
---
<BaseLayout locale={locale} title="Mind Sherpa" description="Mind Sherpa — editorial practice across books, digital publishing, identity, web and video.">
<article class="ms">
  <header class="ms-hero ms-wrap">
    <a class="ms-back" href={`${root}#projects`}>← {title('All projects','Todos los proyectos')}</a>
    <div class="ms-kicker"><span>MIND SHERPA / PUBLISHING · EDITORIAL · CULTURE</span><span>CARLOS LAVADO / ORIGINAL PROFESSIONAL WORK</span></div>
    <h1>{title('Ideas, designed to be read.','Ideas diseñadas para ser leídas.')}</h1>
    <div class="ms-intro"><p>{title('Mind Sherpa brings together books, writing and audiovisual work by Carlos Lavado. My work has extended across cover design, digital editorial production, visual identity, web and video editing.','Mind Sherpa reúne libros, escritura y trabajo audiovisual de Carlos Lavado. Mi trabajo se ha extendido al diseño de portadas, producción editorial digital, identidad visual, web y edición de video.')}</p><p>{title('Rather than separate commissions, this case reads them as one publishing system: how an idea acquires a cover, becomes a reading experience and continues across screen and moving image.','Más que encargos aislados, este caso los entiende como un sistema editorial: cómo una idea adquiere portada, se convierte en experiencia de lectura y continúa en pantalla e imagen en movimiento.')}</p></div>
  </header>

  <section class="ms-hero-art ms-wide">
    <img src={`${A}${covers[0]}`} alt="¿Y si el amor fuese suficiente? — book cover design" fetchpriority="high"/>
    <img src={`${A}${covers[1]}`} alt="El despertar de la conciencia — book cover design"/>
    <img src={`${A}${covers[2]}`} alt="Heredarán las estrellas — book cover design"/>
    <div class="ms-hero-line"><small>ONE BODY OF IDEAS.</small><strong>MANY<br/><i>FORMS.</i></strong></div>
    <DesignTodo note="CÉSAR: diseñar aquí hero editorial Mind Sherpa — books first"/>
  </section>

  <section class="ms-copy ms-wrap"><b>01</b><div><small>01 / CONTEXT</small><h2>{title('A book begins before the first page.','Un libro comienza antes de la primera página.')}</h2><p>{sections.context}</p></div></section>
  <div class="ms-discovery ms-wide">{['DISCOVER','RECOGNIZE','OPEN','READ','RETURN'].map((x,i)=><div><span>0{i+1}</span><b>{x}</b><i>↓</i></div>)}<DesignTodo note="CÉSAR: diseñar aquí secuencia editorial con páginas reales"/></div>

  <section class="ms-copy ms-wrap"><b>02</b><div><small>02 / COVER DESIGN</small><h2>{title('A cover has seconds to create a question.','Una portada tiene segundos para provocar una pregunta.')}</h2><p>{sections.cover}</p><em>ORIGINAL PROFESSIONAL WORK</em></div></section>
  <div class="ms-covers ms-wide">{covers.map((x,i)=><figure><img src={`${A}${x}`} alt={`Mind Sherpa original book cover ${i+1}`} loading="lazy"/><figcaption>BOOK 0{i+1} / ORIGINAL COVER</figcaption></figure>)}<DesignTodo note="CÉSAR: colocar aquí portadas originales en plano"/></div>

  <section class="ms-copy ms-wrap"><b>03</b><div><small>03 / COVER SYSTEM</small><h2>{title('Title, image and recognition at three distances.','Título, imagen y reconocimiento a tres distancias.')}</h2><p>{title('A strong cover must remain legible as an Amazon or Kindle thumbnail, a catalog image and a full-size composition. Contrast and hierarchy carry recognition between scales.','Una portada sólida debe conservar legibilidad como miniatura de Amazon o Kindle, imagen de catálogo y composición a tamaño completo. El contraste y la jerarquía sostienen el reconocimiento entre escalas.')}</p></div></section>
  <div class="ms-scale ms-wide"><img src={`${A}${covers[0]}`} alt="Cover shown at full scale"/><img src={`${A}${covers[0]}`} alt="Cover shown at catalog scale"/><img src={`${A}${covers[0]}`} alt="Cover shown at thumbnail scale"/><aside><span>TITLE</span><span>AUTHOR</span><span>IMAGE</span><span>HIERARCHY</span></aside><DesignTodo note="CÉSAR: diseñar aquí cover scale test — thumbnail / catalog / full"/></div>

  <section class="ms-copy ms-wrap"><b>04</b><div><small>04 / COLLECTION SYSTEM</small><em>CONTEMPORARY SYSTEM EXTRACTION</em><h2>{title('Different books should feel related without becoming identical.','Libros distintos deben sentirse relacionados sin volverse idénticos.')}</h2><p>{title('Continuity comes from author identification, metadata hierarchy and production rules. Image, color, composition, title scale and texture remain free to respond to each publication.','La continuidad nace de la identificación del autor, la jerarquía de metadatos y las reglas de producción. Imagen, color, composición, escala del título y textura responden libremente a cada publicación.')}</p></div></section>
  <div class="ms-collection ms-wide"><img src={`${A}Libros.jpg`} alt="Mind Sherpa original collection of books"/><div><small>CONSTANT</small>{['AUTHOR','TYPE LOGIC','METADATA','EDITORIAL TONE'].map(x=><span>{x}</span>)}</div><div><small>VARIABLE</small>{['IMAGE','COLOR','COMPOSITION','TEXTURE'].map(x=><span>{x}</span>)}</div></div>

  <section class="ms-copy ms-wrap"><b>05</b><div><small>05 / EDITORIAL DESIGN</small><h2>{title('The cover earns attention. The interior has to sustain it.','La portada gana atención. El interior debe sostenerla.')}</h2><p>{sections.interior}</p><em>ORIGINAL PROFESSIONAL WORK</em></div></section>
  <div class="ms-pages ms-wide">{['TITLE PAGE','CONTENTS','CHAPTER','BODY TEXT','QUOTATION','REFERENCES'].map((x,i)=><article><small>0{i+1}</small><h3>{x}</h3><p>{i===2?'Ideas need a structure that lets the reader remain inside the argument.':'Mind Sherpa / Carlos Lavado'}</p></article>)}<DesignTodo note="CÉSAR: colocar aquí Kindle/editorial interiors"/></div>
  <div class="ms-editorial-evidence ms-wide"><figure><img src={`${A}mindsherpa_3.webp`} alt="Mind Sherpa original editorial interior system" loading="lazy"/><figcaption>EDITORIAL INTERIORS / ORIGINAL PROFESSIONAL WORK</figcaption></figure><figure><img src={`${A}mindsherpa_6.webp`} alt="Mind Sherpa original twelve-page reading sequence" loading="lazy"/><figcaption>READING SEQUENCE / ORIGINAL PROFESSIONAL WORK</figcaption></figure></div>

  <section class="ms-copy ms-wrap"><b>06</b><div><small>06 / DIGITAL PUBLISHING</small><h2>{title('Designing for a page that can change size.','Diseñar para una página que puede cambiar de tamaño.')}</h2><p>{sections.kindle}</p><em>ORIGINAL PROFESSIONAL WORK</em></div></section>
  <div class="ms-reflow ms-wide">{['DESKTOP / TABLET','E-READER','MOBILE'].map((x,i)=><article class={`r${i}`}><small>{x}</small><h3>CHAPTER 04</h3><h4>{title('The form of an idea','La forma de una idea')}</h4><p>{title('The reading system preserves title, chapter, section and body relationships as available width changes.','El sistema conserva las relaciones entre título, capítulo, sección y cuerpo cuando cambia el ancho disponible.')}</p><hr/><p>{title('Content continues through reflow.','El contenido continúa mediante reflujo.')}</p></article>)}<DesignTodo note="CÉSAR: crear aquí Kindle responsive reading sequence"/></div>
  <figure class="ms-kindle-proof ms-wide"><img src={`${A}mindsherpa_2.webp`} alt="Mind Sherpa chapter shown across desktop, tablet and mobile reading widths" loading="lazy"/><figcaption>DIGITAL PUBLISHING / RESPONSIVE READING / ORIGINAL PROFESSIONAL WORK</figcaption></figure>

  <section class="ms-copy ms-wrap"><b>07</b><div><small>07 / TYPE SYSTEM</small><h2>{title('Structure that survives hundreds of pages.','Una estructura que sobrevive cientos de páginas.')}</h2><p>{title('Long-form reading relies on repeated relationships, not isolated font choices. Each level must remain recognizable through repetition.','La lectura extensa depende de relaciones repetidas, no de fuentes aisladas. Cada nivel debe seguir siendo reconocible a través de la repetición.')}</p></div></section>
  <div class="ms-type ms-wide"><span>BOOK TITLE</span><h2>ONE BODY<br/>OF IDEAS.</h2><span>PART / 02</span><h3>CHAPTER 04</h3><h4>The shape of attention</h4><p>Body paragraph — a comfortable measure supports sustained reading across a longer argument.</p><blockquote>“The hierarchy should be felt before it is named.”</blockquote><small>CAPTION / NOTE / DIVIDER</small><DesignTodo note="CÉSAR: extraer aquí editorial hierarchy"/></div>

  <section class="ms-copy ms-wrap"><b>08</b><div><small>08 / READING RHYTHM</small><h2>{title('Editorial design happens across pages, not inside one page.','El diseño editorial sucede entre páginas, no dentro de una sola.')}</h2><p>{title('Dense sections create concentration. Openings reset. Short passages accelerate. Images interrupt. White space creates pause. A publication is designed as a sequence.','Las secciones densas concentran. Las aperturas reinician. Los pasajes breves aceleran. Las imágenes interrumpen. El espacio crea pausa. Una publicación se diseña como secuencia.')}</p></div></section>
  <div class="ms-rhythm ms-wide">{Array.from({length:15},(_,i)=><i class:list={{dark:[0,5,10].includes(i),quote:[4,9,13].includes(i)}}><span>{String(i+1).padStart(2,'0')}</span></i>)}<DesignTodo note="CÉSAR: crear aquí 15-page reading rhythm sequence"/></div>

  <section class="ms-copy ms-wrap"><b>09</b><div><small>09 / PUBLISHING PRODUCTION</small><h2>{title('Editorial design also has to survive the file.','El diseño editorial también debe sobrevivir al archivo.')}</h2><p>{title('Hierarchy, images, spacing, metadata and structural divisions need to remain reliable when the work enters the reader’s device. Production knowledge connects visual decisions with publishing constraints.','Jerarquía, imágenes, espaciado, metadatos y divisiones estructurales deben mantenerse fiables al entrar al dispositivo del lector. El conocimiento de producción conecta decisiones visuales y restricciones editoriales.')}</p></div></section>
  <div class="ms-production ms-wide"><div><small>DOCUMENT STRUCTURE</small>{['BOOK','FRONT MATTER','CHAPTER 01','CHAPTER 02','NOTES'].map(x=><span>{x}</span>)}</div><div><small>STYLE HIERARCHY</small>{['TITLE / H1','CHAPTER / H2','SECTION / H3','BODY','CAPTION'].map(x=><span>{x}</span>)}</div><div><small>OUTPUT CHECK</small>{['REFLOW','IMAGES','DIVIDERS','METADATA','NAVIGATION'].map(x=><span>✓ {x}</span>)}</div><DesignTodo note="CÉSAR: mostrar aquí digital publishing production"/></div>

  <section class="ms-copy ms-wrap"><b>10</b><div><small>10 / CONTENT SYSTEM</small><em>CONTEMPORARY SYSTEM EXTRACTION</em><h2>{title('One book can generate many points of entry.','Un libro puede generar muchos puntos de entrada.')}</h2><p>{title('A chapter can become an essay, a passage an excerpt and a concept a video. The book remains the source rather than being reduced to promotional content.','Un capítulo puede convertirse en ensayo, un pasaje en extracto y un concepto en video. El libro permanece como fuente sin reducirse a contenido promocional.')}</p></div></section>
  <div class="ms-content ms-wide"><img src={`${A}${covers[3]}`} alt="Un año de perdón original cover"/>{[['BOOK','LONG-FORM ARGUMENT'],['ESSAY','FOCUSED IDEA'],['VIDEO','TEMPORAL INTERPRETATION'],['EXCERPT','ENTRY POINT'],['QUOTE','RECOGNITION']].map(x=><div><b>{x[0]}</b><span>{x[1]}</span></div>)}</div>

  <section class="ms-copy ms-wrap"><b>11</b><div><small>11 / VISUAL IDENTITY</small><h2>{title('An identity quiet enough to let the work speak.','Una identidad lo bastante silenciosa para dejar hablar a la obra.')}</h2><p>{title('Recognition frames the publications without imposing one appearance on every title. Typography, color and recurring composition establish continuity across publishing and digital communication.','El reconocimiento enmarca las publicaciones sin imponer una sola apariencia a cada título. Tipografía, color y composición recurrente crean continuidad editorial y digital.')}</p><em>ORIGINAL PROFESSIONAL WORK</em></div></section>
  <div class="ms-identity ms-wide"><img src={`${A}JESUS-Y-ANANDA-LOGO.png`} alt="Carlos Lavado original identity"/><div><strong>Aa</strong><span>EDITORIAL / DISPLAY</span></div><div class="swatches"><i>#442943</i><i>#EDB4CB</i><i>#F1EEE6</i></div><DesignTodo note="CÉSAR: colocar aquí identidad original"/></div>

  <section class="ms-copy ms-wrap"><b>12</b><div><small>12 / DIGITAL ARCHIVE</small><h2>{title('A home for work designed to outlive the feed.','Un hogar para trabajo diseñado para sobrevivir al feed.')}</h2><p>{title('The website gives publications, ideas and audiovisual material a shared place organized around subjects and relationships rather than chronology.','El sitio reúne publicaciones, ideas y material audiovisual en un espacio organizado por temas y relaciones, no solo por cronología.')}</p><em>ORIGINAL PROFESSIONAL WORK</em></div></section>
  <figure class="ms-web ms-wide"><img src={`${A}TablerCarlos.png`} alt="Original Carlos Lavado website designed by César"/><figcaption>ORIGINAL WEBSITE / DESKTOP VIEWS</figcaption><DesignTodo note="CÉSAR: colocar aquí website original"/></figure>

  <section class="ms-copy ms-wrap"><b>13</b><div><small>13 / PUBLICATION EXPERIENCE</small><em>CONTEMPORARY EXTENSION</em><h2>{title('Let the book remain the protagonist.','Dejar que el libro siga siendo protagonista.')}</h2><p>{title('A publication page gives context without reducing the work to a generic ecommerce card: cover, synopsis, format, language, selected passage and related material.','Una página editorial da contexto sin reducir la obra a una tarjeta de comercio: portada, sinopsis, formato, idioma, pasaje seleccionado y material relacionado.')}</p></div></section>
  <div class="ms-detail ms-wide"><img src={`${A}${covers[2]}`} alt="Heredarán las estrellas cover"/><div><small>CARLOS LAVADO / PUBLICATION</small><h2>HEREDARÁN<br/>LAS ESTRELLAS</h2><p>{title('A selected publication presented through its own voice, visual character and relationship to the wider body of work.','Una publicación presentada desde su propia voz, carácter visual y relación con el cuerpo completo de obra.')}</p><span>FORMAT / DIGITAL</span><span>LANGUAGE / SPANISH</span><b>{title('Read selected passage →','Leer pasaje seleccionado →')}</b></div><DesignTodo note="CÉSAR: diseñar aquí publication detail conceptual"/></div>

  <section class="ms-copy ms-wrap"><b>14</b><div><small>14 / PUBLISHING CATALOG</small><em>CONTEMPORARY EXTENSION</em><h2>{title('From individual titles to a body of work.','De títulos individuales a un cuerpo de obra.')}</h2><p>{title('A catalog organizes publications by subject, format or thematic relationship while preserving the individuality of each cover.','Un catálogo organiza publicaciones por tema, formato o relación temática mientras conserva la individualidad de cada portada.')}</p></div></section>
  <div class="ms-catalog ms-wide"><nav>BOOKS <span>ESSAYS</span><span>VIDEO</span><i>ALL THEMES ↓</i></nav>{covers.map((x,i)=><figure><img src={`${A}${x}`} alt={`Publication ${i+1}`}/><figcaption>CARLOS LAVADO / 0{i+1}</figcaption></figure>)}<DesignTodo note="CÉSAR: diseñar aquí publishing catalog conceptual"/></div>
  <figure class="ms-catalog-proof ms-wide"><img src={`${A}mindsherpa_4.webp`} alt="Mind Sherpa publishing catalog with six real titles" loading="lazy"/><figcaption>PUBLISHING CATALOG / ORIGINAL TITLES</figcaption></figure>

  <section class="ms-copy ms-wrap"><b>15</b><div><small>15 / AUDIOVISUAL</small><h2>{title('When the page starts moving.','Cuando la página comienza a moverse.')}</h2><p>{title('My audiovisual work extended the publishing identity into moving image through video editing, typography and the organization of visual material. The role was editing and related visual work—not filming or cinematography.','Mi trabajo audiovisual extendió la identidad editorial hacia la imagen en movimiento mediante edición de video, tipografía y organización del material visual. El rol fue edición y trabajo gráfico relacionado, no filmación ni cinematografía.')}</p><em>ORIGINAL PROFESSIONAL WORK</em></div></section>
  <div class="ms-audiovisual ms-wide"><figure><img src={`${A}mindsherpa_1.webp`} alt="Mind Sherpa audiovisual edition and filmstrip" loading="lazy"/><figcaption>AUDIOVISUAL EDITION / ORIGINAL PROFESSIONAL WORK</figcaption></figure><figure><img src={`${A}mindsherpa_5.webp`} alt="Mind Sherpa audiovisual publishing sequence" loading="lazy"/><figcaption>VIDEO SEQUENCE / ORIGINAL PROFESSIONAL WORK</figcaption></figure></div>
  <section class="ms-playlist ms-wide"><div><small>MIND SHERPA / VIDEO ARCHIVE</small><h3>{title('Publishing in moving image.','La publicación en imagen en movimiento.')}</h3><p>{title('A playlist of audiovisual work connected to the books, ideas and editorial practice.','Una playlist de trabajo audiovisual conectado con los libros, ideas y práctica editorial.')}</p><a href="https://www.youtube.com/watch?v=0FConfa6so8&list=PLTUSuOPQB8Cg" target="_blank" rel="noopener noreferrer">{title('Open playlist on YouTube ↗','Abrir playlist en YouTube ↗')}</a></div><div class="ms-player"><iframe src="https://www.youtube-nocookie.com/embed/videoseries?list=PLTUSuOPQB8Cg" title="Mind Sherpa audiovisual playlist" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div></section>

  <section class="ms-copy ms-wrap"><b>16</b><div><small>16 / VIDEO EDITING</small><h2>{title('Editing turns material into an argument.','La edición convierte el material en argumento.')}</h2><p>{title('Footage, photographs, archive, titles, narration and music become coherent when their sequence establishes meaning. The edit controls what appears, for how long and what comes next.','Video, fotografía, archivo, títulos, narración y música se vuelven coherentes cuando su secuencia establece significado. La edición controla qué aparece, cuánto permanece y qué sigue.')}</p></div></section>
  <div class="ms-timeline ms-wide">{[['00:00','OPEN'],['00:18','CONTEXT'],['00:47','ARCHIVE'],['01:20','KEY IDEA'],['02:10','TRANSITION'],['03:00','CLOSE']].map(x=><div><b>{x[0]}</b><span>{x[1]}</span><i></i></div>)}<DesignTodo note="CÉSAR: crear aquí editing rhythm filmstrip"/></div>

  <section class="ms-copy ms-wrap"><b>17</b><div><small>17 / MOTION LANGUAGE</small><em>CONTEMPORARY MOTION EXTENSION</em><h2>{title('The hierarchy changes when it has duration.','La jerarquía cambia cuando tiene duración.')}</h2><p>{title('Titles, quotations, names and transitions use editorial sensitivity while adapting scale and duration to audiovisual pacing.','Títulos, citas, nombres y transiciones conservan sensibilidad editorial mientras adaptan escala y duración al ritmo audiovisual.')}</p></div></section>
  <div class="ms-motion ms-wide">{['OPENING TITLE','CHAPTER TITLE','QUOTE','LOWER THIRD','CLOSING'].map((x,i)=><div><small>0{i+1}</small><b>{x}</b></div>)}<DesignTodo note="CÉSAR: colocar aquí title/motion system"/></div>

  <section class="ms-copy ms-wrap"><b>18</b><div><small>18 / EDITORIAL ECOSYSTEM</small><h2>{title('The medium changes. The voice remains recognizable.','El medio cambia. La voz permanece reconocible.')}</h2><p>{title('Cover creates recognition. The book sustains reading. Web supports discovery. Video organizes time. Identity creates continuity.','La portada crea reconocimiento. El libro sostiene la lectura. La web facilita el descubrimiento. El video organiza el tiempo. La identidad crea continuidad.')}</p></div></section>
  <div class="ms-ecosystem ms-wide"><img src={`${A}${covers[0]}`} alt="Book at center of the editorial ecosystem"/><img src={`${A}TablerCarlos.png`} alt="Web within the editorial ecosystem"/><img src={`${A}PSD-TYHUMB.jpg`} alt="Audiovisual work within the editorial ecosystem"/><div>BOOK<br/><i>WEB</i><br/>VIDEO</div><DesignTodo note="CÉSAR: diseñar aquí books + web + video ecosystem"/></div>

  <section class="ms-copy ms-wrap"><b>19</b><div><small>19 / ORIGINAL WORK</small><h2>{title('The work as it was produced.','El trabajo tal como fue producido.')}</h2><p>{title('The covers, editorial publications, identity, website and audiovisual pieces shown here were developed as professional work for Mind Sherpa and Carlos Lavado. Together they form an ongoing body of work across publishing, digital communication and moving image.','Las portadas, publicaciones editoriales, identidad, sitio web y piezas audiovisuales aquí mostradas fueron desarrolladas como trabajo profesional para Mind Sherpa y Carlos Lavado. Juntas forman un cuerpo de trabajo continuo entre publicación, comunicación digital e imagen en movimiento.')}</p><em>ORIGINAL PROFESSIONAL WORK</em></div></section>
  <div class="ms-archive ms-wide">{completeArchive.map((x,i)=><img src={`${A}${x}`} alt={`Mind Sherpa original professional archive ${i+1}`} loading="lazy"/>)}<DesignTodo note="CÉSAR: colocar aquí complete original professional archive"/></div>

  <section class="ms-copy ms-wrap"><b>20</b><div><small>20 / CONTEMPORARY EXTENSION</small><em>2026 CONTEMPORARY EDITORIAL EXTENSION</em><h2>{title('Turning individual publications into a publishing system.','Convertir publicaciones individuales en un sistema editorial.')}</h2><p>{title('Recurring structures across covers, hierarchy, reading, themes, digital discovery and audiovisual adaptation can become a more explicit editorial system without rewriting the history of the original work.','Las estructuras recurrentes entre portadas, jerarquía, lectura, temas, descubrimiento digital y adaptación audiovisual pueden convertirse en un sistema explícito sin reescribir la historia del trabajo original.')}</p></div></section>
  <div class="ms-system ms-wide"><header>ONE BODY OF IDEAS. <b>MANY FORMS.</b></header>{['BOOKS','EDITORIAL','DIGITAL PUBLISHING','IDENTITY','WEB','VIDEO'].map((x,i)=><div><span>0{i+1}</span><strong>{x}</strong></div>)}<DesignTodo note="CÉSAR: diseñar aquí contemporary editorial system"/></div>

  <section class="ms-copy ms-reflection ms-wrap"><b>21</b><div><small>21 / REFLECTION</small><h2>{title('Designing a book means designing how an idea travels.','Diseñar un libro significa diseñar cómo viaja una idea.')}</h2><p>{title('A cover has seconds to attract attention. A book supports hours of reading. A website makes the work discoverable. A video organizes ideas through time. The common problem is giving content the right form for the medium carrying it.','Una portada tiene segundos para atraer. Un libro sostiene horas de lectura. Un sitio vuelve la obra descubrible. Un video organiza ideas en el tiempo. El problema común es dar al contenido la forma adecuada para el medio que lo transporta.')}</p><div>{capabilities.map(x=><span>{x}</span>)}</div><em>Original professional publishing, identity, web and audiovisual work + selected contemporary editorial extensions.</em></div></section>
  <footer class="ms-final ms-wide"><img src={`${A}Libros.jpg`} alt="Mind Sherpa publishing ecosystem"/><div><small>MIND SHERPA / PUBLISHING ACROSS MEDIA</small><h2>ONE BODY<br/>OF IDEAS.<br/><i>MANY FORMS.</i></h2></div><DesignTodo note="CÉSAR: diseñar aquí final publishing ecosystem"/></footer>
  <a class="ms-next ms-wrap" href={`${root}project/airtm/`}><span>NEXT PROJECT</span><strong>AirTM</strong><b>↗</b></a>
</article>
</BaseLayout>
